# BETMAN_DATA local environment template
#
# Generate strong secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Copy this file to .env and replace every change-me value before running compose.

POSTGRES_DB=betman
POSTGRES_USER=betman
POSTGRES_PASSWORD=change-me-postgres-password

DATABASE_URL=******postgres:5432/betman
REDIS_URL=redis://redis:6379/0
QUEUE_URL=redis://redis:6379/1

MINIO_ROOT_USER=betman
MINIO_ROOT_PASSWORD=change-me-minio-password
MEDIA_BASE_URL=http://minio:9000/betman-media
CDN_BASE_URL=http://localhost:9000/betman-media
STORAGE_BASE_PATH=s3://betman-media

ADMIN_API_KEY=change-me-admin-api-key
WEBAPP_READONLY_API_KEY=change-me-webapp-readonly-api-key
# keep this aligned with WEBAPP_READONLY_API_KEY; do not use the admin key here
API_PROXY_AUTHORIZATION=******
# Used only after the Data gate verifies the BETMAN admin session. When omitted,
# server.cjs derives this header from ADMIN_API_KEY.
API_ADMIN_PROXY_AUTHORIZATION=******
PLATFORM_MASTER_KEY=change-me-platform-master-key

# Native Data Viewer authentication delegates to BETMAN Core. Only this Core
# username receives Data admin access; every other valid Core user is read-only.
BETMAN_CORE_ORIGIN=http://betman-core:18081
BETMAN_DATA_ADMIN_USER=betman
BETMAN_DATA_AUTH_SECRET=change-me-data-session-secret
BETMAN_DATA_AUTH_TOKEN_TTL_MS=28800000

CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ENVIRONMENT=development
LOG_LEVEL=debug
WEATHERLINK_BASE_URL=https://api.weatherlink.com/v2
