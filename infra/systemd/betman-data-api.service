[Unit]
Description=BETMAN DATA API
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
WorkingDirectory=/opt/betman/betman_data/services/api
EnvironmentFile=/etc/betman/betman-data.env
ExecStart=/opt/betman/betman_data/services/api/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 18086
Restart=always
RestartSec=5
User=betman
Group=betman
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/betman/betman_data /var/log/betman
MemoryMax=384M
MemoryHigh=256M
TasksMax=96
LimitNOFILE=8192
StandardOutput=append:/var/log/betman/betman-data-api.out.log
StandardError=append:/var/log/betman/betman-data-api.err.log

[Install]
WantedBy=multi-user.target
