# BETMAN Data API — environment variables
# Prefer copying the root .env.example to /.env for full-stack development.
# This service-local file is only for running the API in isolation.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=******localhost:5432/betman

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Media & CDN ───────────────────────────────────────────────────────────────
MEDIA_BASE_URL=http://localhost:9000/betman-media
CDN_BASE_URL=http://localhost:9000/betman-media

# ── Security ──────────────────────────────────────────────────────────────────
# Admin API key — required for admin-scoped access.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me-in-production

# AES-256 key for decrypting api_key_configs.encrypted_key
PLATFORM_MASTER_KEY=change-me-to-a-32-byte-hex-string-in-production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
ENVIRONMENT=development
API_VERSION=1.0.0
