# BETMAN Consumer Service — environment variables
# Copy to .env and fill in values before running.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=******localhost:5432/betman

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
QUEUE_URL=redis://localhost:6379/1

# ── Object storage ────────────────────────────────────────────────────────────
STORAGE_BASE_PATH=s3://betman-media
STORAGE_REGION=ap-southeast-2

# ── Security ──────────────────────────────────────────────────────────────────
# AES-256 key used to decrypt api_key_configs.encrypted_key at runtime.
# Must be exactly 32 bytes (256 bits). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
PLATFORM_MASTER_KEY=change-me-to-a-32-byte-hex-string-in-production

# ── HLS feed polling ──────────────────────────────────────────────────────────
HLS_POLL_INTERVAL_S=2.0
HLS_SEGMENT_TIMEOUT_S=10.0
HLS_MAX_RETRIES=3

# ── Race data ─────────────────────────────────────────────────────────────────
RACE_DATA_POLL_INTERVAL_S=30.0

# ── Odds ──────────────────────────────────────────────────────────────────────
ODDS_POLL_INTERVAL_S=10.0
ODDS_STEAM_THRESHOLD_PCT=20.0
ODDS_BLOWOUT_THRESHOLD_PCT=20.0
ODDS_LATE_FIRM_WINDOW_S=600

# ── WeatherLink ───────────────────────────────────────────────────────────────
WEATHERLINK_POLL_INTERVAL_S=60.0
WEATHERLINK_BASE_URL=https://api.weatherlink.com/v2

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
ENVIRONMENT=development
